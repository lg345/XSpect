   "id": "md-references",
   "metadata": {},
   "source": [
    "## 5. Speciation — IAD / LCF vs reference spectra (optional)\n",
    "\n",
    "> Provide reference spectra (e.g. pure Fe(II) and Fe(III) standards) to enable\n",
    "> quantitative speciation. Point `REF_FILES` at other `runs_*_static_xes.h5`\n",
    "> files (or leave empty to skip). Each reference is loaded, cropped to the same\n",
    "> window, baseline-subtracted, area-normalized, and **interpolated onto run 9's\n",
    "> energy grid** so IAD/LCF are computed pixel-for-pixel on a common axis."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "cell-refs",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "No reference spectra configured — skipping IAD/LCF. Populate REF_FILES to enable quantitative speciation.\n"
     ]
    }
   ],
   "source": [
    "# Map a human label -> results HDF5 file for each reference spectrum.\n",
    "# Example (fill in when standards are measured):\n",
    "#   REF_FILES = {\n",
    "#       'Fe(II)':  os.path.join(RESULTS, 'runs_11_static_xes.h5'),\n",
    "#       'Fe(III)': os.path.join(RESULTS, 'runs_12_static_xes.h5'),\n",
    "#   }\n",
    "REF_FILES = {}\n",
    "\n",
    "def load_processed(h5_file, run_key, energy_key, win, deg, niter, tol):\n",
    "    \"\"\"Load a spectrum, crop, baseline-subtract, area-normalize — same pipeline\n",
    "    as run 9 above. Returns (energy, normalized_spec).\"\"\"\n",
    "    with h5py.File(h5_file, 'r') as fh:\n",
    "        e_full = fh[energy_key][:]\n",
    "        # pick the single run group present in the file\n",
    "        rk = run_key if run_key in fh else next(k for k in fh if k.startswith('run_'))\n",
    "        line = 'kalpha' if 'kalpha' in energy_key else 'kbeta'\n",
    "        s_full = np.asarray(fh[f'{rk}/{line}'][:], dtype=float)\n",
    "    e, s = crop(e_full, s_full, win)\n",
    "    corr, _, _ = subtract_baseline(e, s, deg, niter, tol)\n",
    "    norm, _ = area_normalize(e, corr)\n",
    "    return e, norm\n",
    "\n",
    "def resample(e_src, y_src, e_dst):\n",
    "    \"\"\"Interpolate y_src(e_src) onto e_dst, then re-area-normalize.\"\"\"\n",
    "    y = np.interp(e_dst, e_src, y_src, left=0.0, right=0.0)\n",
    "    area = np.trapz(y, e_dst)\n",
    "    return y / area if area > 0 else y\n",
    "\n",
    "refs = {'kalpha': {}, 'kbeta': {}}\n",
    "for label, path in REF_FILES.items():\n",
    "    e_ka_r, y_ka_r = load_processed(path, None, 'kalpha_energy', KA_WIN, KA_DEG, KA_NITER, KA_TOL)\n",
    "    e_kb_r, y_kb_r = load_processed(path, None, 'kbeta_energy',  KB_WIN, KB_DEG, KB_NITER, KB_TOL)\n",
    "    refs['kalpha'][label] = resample(e_ka_r, y_ka_r, ka_e)\n",
    "    refs['kbeta'][label]  = resample(e_kb_r, y_kb_r, kb_e)\n",
    "\n",
    "if not REF_FILES:\n",
    "    print('No reference spectra configured — skipping IAD/LCF. '\n",
    "          'Populate REF_FILES to enable quantitative speciation.')\n",
    "else:\n",
    "    print(f'Loaded {len(REF_FILES)} reference(s): {list(REF_FILES)}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
