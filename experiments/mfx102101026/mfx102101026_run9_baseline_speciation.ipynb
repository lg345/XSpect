    "## 3. Normalization\n",
    "\n",
    "Area-normalize the baseline-subtracted spectra (negative residuals clipped to\n",
    "0 first so the integral is the true peak area). Both raw-area and unit-height\n",
    "normalizations are shown."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "cell-norm",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1400x400 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Kα integrated peak area (baseline-sub): 72149.6 ADU·eV\n",
      "Kβ integrated peak area (baseline-sub): 20260.3 ADU·eV\n"
     ]
    }
   ],
   "source": [
    "def area_normalize(energy, spec, clip_negative=True):\n",
    "    y = np.asarray(spec, dtype=float).copy()\n",
    "    if clip_negative:\n",
    "        y[y < 0] = 0.0\n",
    "    area = np.trapz(y, energy)\n",
    "    return y / area if area > 0 else y, area\n",
    "\n",
    "ka_norm, ka_area = area_normalize(ka_e, ka_corr)\n",
    "kb_norm, kb_area = area_normalize(kb_e, kb_corr)\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 4))\n",
    "axes[0].plot(ka_e, ka_norm, color='C3'); axes[0].set_title('Fe Kα (baseline-sub, area-norm)')\n",
    "axes[1].plot(kb_e, kb_norm, color='C0'); axes[1].set_title('Fe Kβ (baseline-sub, area-norm)')\n",
    "for ax in axes:\n",
    "    ax.set_xlabel('Emission energy (eV)')\n",
    "    ax.set_ylabel('Normalized intensity (1/eV)')\n",
    "    ax.grid(alpha=0.3)\n",
    "plt.tight_layout(); plt.show()\n",
    "\n",
    "print(f'Kα integrated peak area (baseline-sub): {ka_area:.1f} ADU·eV')\n",
    "print(f'Kβ integrated peak area (baseline-sub): {kb_area:.1f} ADU·eV')"
   ]
  },
