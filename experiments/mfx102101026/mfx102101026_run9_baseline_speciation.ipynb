   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "REF_FILES empty — nothing to compare.\n"
     ]
    }
   ],
   "source": [
    "if REF_FILES:\n",
    "    def iad(sample, ref, energy):\n",
    "        return float(np.trapz(np.abs(sample - ref), energy))\n",
    "\n",
    "    def lcf_two(sample, ref_a, ref_b):\n",
    "        \"\"\"Least-squares fraction f such that sample ≈ f·ref_a + (1−f)·ref_b.\"\"\"\n",
    "        basis = ref_a - ref_b\n",
    "        denom = np.dot(basis, basis)\n",
    "        if denom == 0:\n",
    "            return np.nan\n",
    "        return float(np.dot(basis, sample - ref_b) / denom)\n",
    "\n",
    "    for line, e, sample in [('kalpha', ka_e, ka_norm), ('kbeta', kb_e, kb_norm)]:\n",
    "        sample_n = sample.copy(); sample_n[sample_n < 0] = 0\n",
    "        a = np.trapz(sample_n, e); sample_n = sample_n / a if a > 0 else sample_n\n",
    "        print(f'\\n=== {line} ===')\n",
    "        for label, ref in refs[line].items():\n",
    "            print(f'  IAD vs {label}: {iad(sample_n, ref, e):.4e}')\n",
    "        labels = list(refs[line])\n",
    "        if len(labels) >= 2:\n",
    "            f = lcf_two(sample_n, refs[line][labels[0]], refs[line][labels[1]])\n",
    "            print(f'  LCF: {f*100:.1f}% {labels[0]} + {(1-f)*100:.1f}% {labels[1]}')\n",
    "\n",
    "    # overlay plot\n",
    "    fig, axes = plt.subplots(1, 2, figsize=(14, 4))\n",
    "    for ax, line, e, sample, lbl in [\n",
    "        (axes[0], 'kalpha', ka_e, ka_norm, 'Fe Kα'),\n",
    "        (axes[1], 'kbeta',  kb_e, kb_norm, 'Fe Kβ'),\n",
    "    ]:\n",
    "        ax.plot(e, sample, 'k-', lw=1.6, label='run 9')\n",
    "        for label, ref in refs[line].items():\n",
    "            ax.plot(e, ref, lw=1.1, alpha=0.8, label=f'ref: {label}')\n",
    "        ax.set_title(f'{lbl}: run 9 vs references')\n",
    "        ax.set_xlabel('Emission energy (eV)'); ax.set_ylabel('Norm. intensity')\n",
    "        ax.legend(fontsize=8); ax.grid(alpha=0.3)\n",
    "    plt.tight_layout(); plt.show()\n",
    "else:\n",
    "    print('REF_FILES empty — nothing to compare.')"
   ]
  },
