    "import os\n",
    "import h5py\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "HERE    = os.path.dirname(os.path.abspath('__file__'))\n",
    "RESULTS = os.path.join(HERE, 'results')\n",
    "RUN     = 9\n",
    "H5_FILE = os.path.join(RESULTS, f'runs_{RUN}_static_xes.h5')\n",
    "\n",
    "# Analysis windows (eV)\n",
    "KA_WIN = (6380.0, 6410.0)\n",
    "KB_WIN = (7031.0, 7075.0)\n",
    "\n",
    "with h5py.File(H5_FILE, 'r') as fh:\n",
    "    ka_energy = fh['kalpha_energy'][:]\n",
    "    kb_energy = fh['kbeta_energy'][:]\n",
    "    ka_raw    = np.asarray(fh[f'run_{RUN}/kalpha'][:], dtype=float)\n",
    "    kb_raw    = np.asarray(fh[f'run_{RUN}/kbeta'][:], dtype=float)\n",
    "    total_shots = int(fh[f'run_{RUN}'].attrs.get('total_shots', 0))\n",
    "\n",
    "print(f'Loaded run {RUN}: {total_shots} shots')\n",
    "print(f'  Kα axis: {ka_energy.min():.1f}–{ka_energy.max():.1f} eV  (window {KA_WIN})')\n",
    "print(f'  Kβ axis: {kb_energy.min():.1f}–{kb_energy.max():.1f} eV  (window {KB_WIN})')\n",
    "\n",
    "# Sanity: make sure the windows are inside the measured axes\n",
    "for lbl, e, win in [('Kα', ka_energy, KA_WIN), ('Kβ', kb_energy, KB_WIN)]:\n",
    "    if win[0] < e.min() or win[1] > e.max():\n",
    "        print(f'  WARNING: {lbl} window {win} extends beyond measured axis '\n",
    "              f'[{e.min():.1f}, {e.max():.1f}] — it will be clipped.')"
   ]
  },
