   "source": [
    "## 4. Speciation — peak metrics\n",
    "\n",
    "Scalar descriptors computed on the baseline-subtracted, area-normalized\n",
    "spectra, restricted to the analysis windows:\n",
    "\n",
    "- **Centroid** (intensity-weighted mean energy) — sensitive to oxidation state.\n",
    "- **FWHM** — spin-state / ligand-field sensitive (esp. Kβ).\n",
    "- **Peak energy** (argmax).\n",
    "\n",
    "For a single run these are the primary speciation observables. IAD / LCF\n",
    "(next cell) require reference spectra."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "cell-metrics",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "      metric        Fe Kα        Fe Kβ\n",
      "--------------------------------------\n",
      "    centroid   6399.94 eV   7055.19 eV\n",
      " peak_energy   6404.46 eV   7054.53 eV\n",
      "        fwhm      2.29 eV      3.59 eV\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1400x400 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "def peak_metrics(energy, spec):\n",
    "    y = np.asarray(spec, dtype=float).copy()\n",
    "    y[y < 0] = 0.0\n",
    "    if y.sum() <= 0:\n",
    "        return dict(centroid=np.nan, peak_energy=np.nan, fwhm=np.nan)\n",
    "    centroid = np.sum(energy * y) / np.sum(y)\n",
    "    peak_e   = energy[np.argmax(y)]\n",
    "    # FWHM via half-max crossings (linear interpolation)\n",
    "    half = y.max() / 2.0\n",
    "    above = np.where(y >= half)[0]\n",
    "    if len(above) >= 2:\n",
    "        lo_i, hi_i = above[0], above[-1]\n",
    "        # interpolate left edge\n",
    "        if lo_i > 0:\n",
    "            e0, e1 = energy[lo_i - 1], energy[lo_i]\n",
    "            y0, y1 = y[lo_i - 1], y[lo_i]\n",
    "            e_lo = e0 + (half - y0) * (e1 - e0) / (y1 - y0) if y1 != y0 else e1\n",
    "        else:\n",
    "            e_lo = energy[lo_i]\n",
    "        if hi_i < len(y) - 1:\n",
    "            e0, e1 = energy[hi_i], energy[hi_i + 1]\n",
    "            y0, y1 = y[hi_i], y[hi_i + 1]\n",
    "            e_hi = e0 + (half - y0) * (e1 - e0) / (y1 - y0) if y1 != y0 else e0\n",
    "        else:\n",
    "            e_hi = energy[hi_i]\n",
    "        fwhm = abs(e_hi - e_lo)\n",
    "    else:\n",
    "        fwhm = np.nan\n",
    "    return dict(centroid=centroid, peak_energy=peak_e, fwhm=fwhm)\n",
    "\n",
    "ka_m = peak_metrics(ka_e, ka_norm)\n",
    "kb_m = peak_metrics(kb_e, kb_norm)\n",
    "\n",
    "print(f'{\"metric\":>12}   {\"Fe Kα\":>10}   {\"Fe Kβ\":>10}')\n",
    "print('-' * 38)\n",
    "for key, unit in [('centroid', 'eV'), ('peak_energy', 'eV'), ('fwhm', 'eV')]:\n",
    "    print(f'{key:>12}   {ka_m[key]:>7.2f} {unit}   {kb_m[key]:>7.2f} {unit}')\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 4))\n",
    "for ax, e, y, m, lbl, col in [\n",
    "    (axes[0], ka_e, ka_norm, ka_m, 'Fe Kα', 'C3'),\n",
    "    (axes[1], kb_e, kb_norm, kb_m, 'Fe Kβ', 'C0'),\n",
    "]:\n",
    "    ax.plot(e, y, color=col, lw=1.4)\n",
    "    ax.axvline(m['centroid'], color='k', ls='--', lw=1, label=f\"centroid {m['centroid']:.2f} eV\")\n",
    "    ax.axvline(m['peak_energy'], color='gray', ls=':', lw=1, label=f\"peak {m['peak_energy']:.2f} eV\")\n",
    "    ax.set_title(f'{lbl}  (FWHM {m[\"fwhm\"]:.2f} eV)')\n",
    "    ax.set_xlabel('Emission energy (eV)'); ax.set_ylabel('Norm. intensity')\n",
    "    ax.legend(fontsize=8); ax.grid(alpha=0.3)\n",
    "plt.tight_layout(); plt.show()"
   ]
  },
