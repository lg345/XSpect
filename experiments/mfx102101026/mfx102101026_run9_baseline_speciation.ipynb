    "def crop(energy, spec, win):\n",
    "    m = (energy >= win[0]) & (energy <= win[1])\n",
    "    return energy[m], spec[m]\n",
    "\n",
    "ka_e, ka_s = crop(ka_energy, ka_raw, KA_WIN)\n",
    "kb_e, kb_s = crop(kb_energy, kb_raw, KB_WIN)\n",
    "print(f'Kα window: {len(ka_e)} pixels ({ka_e.min():.1f}–{ka_e.max():.1f} eV)')\n",
    "print(f'Kβ window: {len(kb_e)} pixels ({kb_e.min():.1f}–{kb_e.max():.1f} eV)')\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 4))\n",
    "axes[0].plot(ka_e, ka_s, color='C3'); axes[0].set_title('Fe Kα (raw, cropped)')\n",
    "axes[1].plot(kb_e, kb_s, color='C0'); axes[1].set_title('Fe Kβ (raw, cropped)')\n",
    "for ax in axes:\n",
    "    ax.set_xlabel('Emission energy (eV)'); ax.set_ylabel('Summed ADU'); ax.grid(alpha=0.3)\n",
    "plt.tight_layout(); plt.show()"
   ]
  },
