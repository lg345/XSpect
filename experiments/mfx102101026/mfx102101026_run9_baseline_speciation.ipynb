   "source": [
    "def subtract_baseline(energy, spec, deg=1, niter=10, tol=1.0):\n",
    "    \"\"\"Iterative lower-envelope polynomial baseline (asymmetric peak-stripping).\n",
    "\n",
    "    Fit a degree-`deg` polynomial, keep only points at or below the fit (within\n",
    "    `tol` × residual σ), refit, and repeat up to `niter` times. Converges to\n",
    "    the background *under* the peaks so peaks never drag the baseline up.\n",
    "\n",
    "    Returns (corrected_spec, baseline, fit_mask).\n",
    "    fit_mask is True for the points used in the final baseline fit.\n",
    "    \"\"\"\n",
    "    spec = np.asarray(spec, dtype=float)\n",
    "    if spec.size == 0 or not np.any(np.isfinite(spec)):\n",
    "        return spec, np.zeros_like(spec), np.zeros_like(spec, dtype=bool)\n",
    "\n",
    "    mask = np.isfinite(spec)\n",
    "    base = np.zeros_like(spec)\n",
    "    for _ in range(niter):\n",
    "        if mask.sum() <= deg + 1:\n",
    "            break\n",
    "        coeffs = np.polyfit(energy[mask], spec[mask], deg)\n",
    "        base = np.polyval(coeffs, energy)\n",
    "        resid = spec - base\n",
    "        # residual scatter of points that lie below the current baseline\n",
    "        below = resid[resid < 0]\n",
    "        sigma = np.std(below) if below.size > 1 else np.std(resid)\n",
    "        new_mask = np.isfinite(spec) & (spec <= base + tol * sigma)\n",
    "        if new_mask.sum() <= deg + 1 or np.array_equal(new_mask, mask):\n",
    "            mask = new_mask if new_mask.sum() > deg + 1 else mask\n",
    "            break\n",
    "        mask = new_mask\n",
    "\n",
    "    return spec - base, base, mask\n",
    "\n",
    "# --- tuning knobs per line ---------------------------------------------------\n",
    "# deg: polynomial degree (2 = quadratic).  niter: refinement passes.\n",
    "# tol: how far above the envelope a point may sit and still be kept (in σ).\n",
    "KA_DEG, KA_NITER, KA_TOL = 2, 10, 1.0\n",
    "KB_DEG, KB_NITER, KB_TOL = 2, 10, 1.0\n",
    "\n",
    "ka_corr, ka_base, ka_fmask = subtract_baseline(ka_e, ka_s, KA_DEG, KA_NITER, KA_TOL)\n",
    "kb_corr, kb_base, kb_fmask = subtract_baseline(kb_e, kb_s, KB_DEG, KB_NITER, KB_TOL)\n",
    "\n",
    "fig, axes = plt.subplots(2, 2, figsize=(14, 8))\n",
    "for row, (e, s, base, corr, fmask, lbl, col) in enumerate([\n",
    "    (ka_e, ka_s, ka_base, ka_corr, ka_fmask, 'Fe Kα', 'C3'),\n",
    "    (kb_e, kb_s, kb_base, kb_corr, kb_fmask, 'Fe Kβ', 'C0'),\n",
    "]):\n",
    "    ax = axes[row][0]\n",
    "    ax.plot(e, s, color=col, lw=1.2, label='raw')\n",
    "    ax.plot(e, base, 'k--', lw=1.2, label=f'{KA_DEG}° lower-envelope baseline')\n",
    "    ax.scatter(e[fmask], s[fmask], s=8, color='gray', zorder=3, label='envelope fit points')\n",
    "    ax.set_title(f'{lbl}: raw + fitted baseline')\n",
    "    ax.set_ylabel('Summed ADU'); ax.legend(fontsize=8); ax.grid(alpha=0.3)\n",
    "\n",
    "    ax = axes[row][1]\n",
    "    ax.plot(e, corr, color=col, lw=1.2)\n",
    "    ax.axhline(0, color='gray', lw=0.8)\n",
    "    ax.set_title(f'{lbl}: baseline-subtracted')\n",
    "    ax.set_ylabel('ADU − baseline'); ax.grid(alpha=0.3)\n",
    "for ax in axes.flat:\n",
    "    ax.set_xlabel('Emission energy (eV)')\n",
    "plt.tight_layout(); plt.show()\n",
    "\n",
    "print(f'Kα baseline: mean level {ka_base.mean():.1f} ADU, '\n",
    "      f'envelope fit on {ka_fmask.sum()}/{len(ka_e)} pixels, '\n",
    "      f'{np.sum(ka_corr < 0)} negative pixels (min {ka_corr.min():.1f})')\n",
    "print(f'Kβ baseline: mean level {kb_base.mean():.1f} ADU, '\n",
    "      f'envelope fit on {kb_fmask.sum()}/{len(kb_e)} pixels, '\n",
    "      f'{np.sum(kb_corr < 0)} negative pixels (min {kb_corr.min():.1f})')"
   ]
  },
