    "# Baseline subtraction is DISABLED — passthrough.\n",
    "# The spectra are used as-is (baseline = 0). ka_corr/kb_corr are kept as the\n",
    "# variable names so all downstream cells work unchanged.\n",
    "ka_base = np.zeros_like(ka_s)\n",
    "kb_base = np.zeros_like(kb_s)\n",
    "ka_corr = ka_s.copy()\n",
    "kb_corr = kb_s.copy()\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 4))\n",
    "axes[0].plot(ka_e, ka_corr, color='C3'); axes[0].set_title('Fe Kα (no baseline subtraction)')\n",
    "axes[1].plot(kb_e, kb_corr, color='C0'); axes[1].set_title('Fe Kβ (no baseline subtraction)')\n",
    "for ax in axes:\n",
    "    ax.set_xlabel('Emission energy (eV)'); ax.set_ylabel('Summed ADU'); ax.grid(alpha=0.3)\n",
    "plt.tight_layout(); plt.show()\n",
    "\n",
    "print('Baseline subtraction disabled — spectra passed through unchanged.')"
   ]
